# Conexão do Postgres usada pelo app em runtime (pooled / pgbouncer).
# Neon e Vercel Postgres entregam essa string com "-pooler" no host.
DATABASE_URL="postgresql://usuario:senha@host-pooler.regiao.aws.neon.tech/planilha?sslmode=require"

# Conexão direta, sem pooler — usada só pelo `prisma migrate`.
# É a mesma string, mas sem o "-pooler" no host.
DIRECT_URL="postgresql://usuario:senha@host.regiao.aws.neon.tech/planilha?sslmode=require"

# Segredo que assina o cookie de sessão.
# Gere um novo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Código de convite para novos cadastros. Quem tiver o código cria conta;
# cada usuário enxerga apenas os próprios dados. Sem esta variável, o
# cadastro fica fechado.
# Gere um com: node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
INVITE_CODE="troque-por-um-codigo-seu"

# Código para trocar a senha pela tela de login ("Esqueci minha senha").
# Quem tiver o código redefine a senha de QUALQUER email, então use um valor
# diferente do INVITE_CODE e só passe a quem precisa. Sem esta variável, a
# troca fica fechada.
# Gere um com: node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
RESET_CODE="troque-por-outro-codigo-seu"

# IA do roteiro (docs/rfc/0004-roteiro-inteligente.md). Chave da API da
# Anthropic (platform.claude.com), cobrada por uso. Sem ela, as sugestões e o
# "Planejar com IA" somem da tela e o resto do app funciona igual.
# Nunca use o prefixo NEXT_PUBLIC_: a chave iria para o navegador.
ANTHROPIC_API_KEY=""
# Limites da IA (opcionais): pedidos por pessoa por dia e teto mensal em US$.
# IA_LIMITE_DIARIO=30
# IA_LIMITE_MENSAL_USD=10
