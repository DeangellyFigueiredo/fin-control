# Conexão do Postgres usada pelo app em runtime (pooled / pgbouncer).
# Neon e Vercel Postgres entregam essa string com "-pooler" no host.
DATABASE_URL="postgresql://usuario:senha@host-pooler.regiao.aws.neon.tech/planilha?sslmode=require"

# Conexão direta, sem pooler — usada só pelo `prisma migrate`.
# É a mesma string, mas sem o "-pooler" no host.
DIRECT_URL="postgresql://usuario:senha@host.regiao.aws.neon.tech/planilha?sslmode=require"

# Segredo que assina o cookie de sessão.
# Gere um novo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Cadastro público de novos usuários.
# Deixe ausente/false em produção. Ligue temporariamente só para criar sua conta,
# e desligue em seguida — o app é de usuário único e os dados são compartilhados
# entre todas as contas cadastradas.
# ALLOW_REGISTRATION="true"
