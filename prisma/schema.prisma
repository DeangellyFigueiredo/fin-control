generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection used by the app at runtime (serverless-friendly).
  url       = env("DATABASE_URL")
  // Direct connection required by `prisma migrate` — pgbouncer cannot run DDL.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Preenchidos pelo passo a passo inicial (/onboarding)
  nickname        String?
  financialStatus String?   @map("financial_status")
  savings         Float     @default(0)
  onboardedAt     DateTime? @map("onboarded_at")
  // Preferências de leitura (paleta do calendário). Segue a conta, não o
  // aparelho — tema e olhinho ficam no navegador, ver src/lib/settings.js.
  settings        Json?

  bankAccounts      BankAccount[]
  categories        Category[]
  transactions      Transaction[]
  monthlySummaries  MonthlySummary[]
  investments       Investment[]
  investmentEntries InvestmentEntry[]
  financialGoals    FinancialGoal[]
  recurringEntries  RecurringEntry[]
  creditCards       CreditCard[]
  debts             Debt[]
  cardBills         CardBill[]
  installments      Installment[]
  categoryRules     CategoryRule[]
  wallets           Wallet[]

  @@map("users")
}

model BankAccount {
  id             String   @id @default(uuid())
  name           String
  color          String   @default("#6c5ce7")
  icon           String   @default("🏦")
  initialBalance Float    @default(0) @map("initial_balance")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  transactions     Transaction[]
  monthlySummaries MonthlySummary[]
  recurringEntries RecurringEntry[]
  creditCards      CreditCard[]
  installments     Installment[]

  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carteira dona do registro. Filtrada junto com o usuário em
  // src/lib/db.js: trocar de carteira troca o conjunto inteiro.
  walletId String @map("wallet_id")
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bank_accounts")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String // INCOME or EXPENSE
  color     String   @default("#6c5ce7")
  icon      String   @default("📌")
  createdAt DateTime @default(now()) @map("created_at")

  transactions     Transaction[]
  recurringEntries RecurringEntry[]
  installments     Installment[]
  categoryRules    CategoryRule[]

  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carteira dona do registro. Filtrada junto com o usuário em
  // src/lib/db.js: trocar de carteira troca o conjunto inteiro.
  walletId String @map("wallet_id")
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("categories")
}

model Transaction {
  id            String   @id @default(uuid())
  date          DateTime
  amount        Float
  type          String // INCOME, EXPENSE or INVESTMENT
  description   String   @default("")
  bankAccountId String   @map("bank_account_id")
  categoryId    String?  @map("category_id")
  // Preenchido quando type = INVESTMENT: para onde o dinheiro foi
  investmentId  String?  @map("investment_id")
  // Preenchido quando a saída é o pagamento de uma dívida
  debtId        String?  @map("debt_id")
  // Lançamento feito depois do fato; não altera o valor atual do
  // investimento, que já reflete o aporte.
  isRetroactive Boolean  @default(false) @map("is_retroactive")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  investment  Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  // SetNull: apagar a dívida não apaga o pagamento — o dinheiro saiu de fato
  debt        Debt?       @relation(fields: [debtId], references: [id], onDelete: SetNull)
  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carteira dona do registro. Filtrada junto com o usuário em
  // src/lib/db.js: trocar de carteira troca o conjunto inteiro.
  walletId    String      @map("wallet_id")
  wallet      Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([bankAccountId])
  @@index([categoryId])
  @@index([investmentId])
  @@index([debtId])
  @@index([type])
  @@index([userId])
  @@map("transactions")
}

model MonthlySummary {
  id              String   @id @default(uuid())
  year            Int
  month           Int
  bankAccountId   String   @map("bank_account_id")
  totalIncome     Float    @default(0) @map("total_income")
  totalExpenses   Float    @default(0) @map("total_expenses")
  balance         Float    @default(0)
  vsPreviousMonth Float    @default(0) @map("vs_previous_month")
  closingBalance  Float    @default(0) @map("closing_balance")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carteira dona do registro. Filtrada junto com o usuário em
  // src/lib/db.js: trocar de carteira troca o conjunto inteiro.
  walletId    String      @map("wallet_id")
  wallet      Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([year, month, bankAccountId])
  @@index([userId])
  @@map("monthly_summaries")
}

model Investment {
  id               String   @id @default(uuid())
  name             String
  type             String // RENDA_FIXA, RENDA_VARIAVEL, CRIPTO, OUTRO
  institution      String   @default("")
  // Cor no gráfico. Atribuída automaticamente na criação, editável depois.
  color            String   @default("#3987e5")
  currentValue     Float    @default(0) @map("current_value")
  totalInvested    Float    @default(0) @map("total_invested")
  profit           Float    @default(0)
  profitPercentage Float    @default(0) @map("profit_percentage")
  cdiPercentage    Float    @default(0) @map("cdi_percentage")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  entries        InvestmentEntry[]
  financialGoals FinancialGoal[]
  transactions   Transaction[]

  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carteira dona do registro. Filtrada junto com o usuário em
  // src/lib/db.js: trocar de carteira troca o conjunto inteiro.
  walletId String @map("wallet_id")
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("investments")
}

model InvestmentEntry {
  id            String   @id @default(uuid())
  investmentId  String   @map("investment_id")
  date          DateTime
  type          String // APORTE, RESGATE, RENDIMENTO
  amount        Float
  description   String   @default("")
  // Aporte lançado depois do fato: entra no histórico sem somar no saldo
  isRetroactive Boolean  @default(false) @map("is_retroactive")
  createdAt     DateTime @default(now()) @map("created_at")

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId     String     @map("user_id")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carteira dona do registro. Filtrada junto com o usuário em
  // src/lib/db.js: trocar de carteira troca o conjunto inteiro.
  walletId   String     @map("wallet_id")
  wallet     Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([investmentId])
  @@index([date])
  @@index([userId])
  @@map("investment_entries")
}

model FinancialGoal {
  id                  String    @id @default(uuid())
  name                String
  type                String // RESERVA_EMERGENCIA, INVESTIMENTO, PATRIMONIO, OUTRO
  targetAmount        Float     @map("target_amount")
  currentAmount       Float     @default(0) @map("current_amount")
  targetDate          DateTime? @map("target_date")
  monthlyContribution Float     @default(0) @map("monthly_contribution")
  investmentId        String?   @map("investment_id")
  isCompleted         Boolean   @default(false) @map("is_completed")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  investment Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)

  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carteira dona do registro. Filtrada junto com o usuário em
  // src/lib/db.js: trocar de carteira troca o conjunto inteiro.
  walletId String @map("wallet_id")
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("financial_goals")
}

model RecurringEntry {
  id            String    @id @default(uuid())
  name          String
  type          String // INCOME or EXPENSE
  amount        Float
  dayOfMonth    Int       @map("day_of_month")
  frequency     String    @default("MONTHLY") // MONTHLY or YEARLY
  monthOfYear   Int?      @map("month_of_year") // only for YEARLY
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  bankAccountId String?   @map("bank_account_id")
  categoryId    String?   @map("category_id")
  creditCardId  String?   @map("credit_card_id")
  notes         String    @default("")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creditCard  CreditCard?  @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carteira dona do registro. Filtrada junto com o usuário em
  // src/lib/db.js: trocar de carteira troca o conjunto inteiro.
  walletId    String       @map("wallet_id")
  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([active])
  @@index([userId])
  @@map("recurring_entries")
}

model CreditCard {
  id              String   @id @default(uuid())
  name            String
  color           String   @default("#6c5ce7")
  icon            String   @default("💳")
  limitAmount     Float    @default(0) @map("limit_amount")
  openingDay      Int      @map("opening_day") // abertura da fatura
  dueDay          Int      @map("due_day") // vencimento da fatura
  paymentDay      Int      @map("payment_day") // dia em que a fatura é paga
  estimatedAmount Float    @default(0) @map("estimated_amount")
  bankAccountId   String?  @map("bank_account_id")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bankAccount  BankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  recurring    RecurringEntry[]
  bills        CardBill[]
  installments Installment[]
  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId       String           @map("user_id")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carteira dona do registro. Filtrada junto com o usuário em
  // src/lib/db.js: trocar de carteira troca o conjunto inteiro.
  walletId     String           @map("wallet_id")
  wallet       Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([active])
  @@index([userId])
  @@map("credit_cards")
}

// Dinheiro emprestado de alguém, que precisa voltar.
//
// Diferente de RecurringEntry: não há valor fixo nem periodicidade. O que
// existe é um total devido e pagamentos irregulares — R$ 100 num mês,
// nenhum no seguinte, R$ 200 no outro. O saldo é calculado somando as
// transações vinculadas, nunca guardado, para não haver duas verdades.
model Debt {
  id             String    @id @default(uuid())
  name           String
  // OWE = eu devo a alguém; LENT = alguém me deve.
  // A conta é a mesma nos dois lados, muda só o tipo da transação que
  // abate o saldo: saída quando eu pago, entrada quando me pagam.
  direction      String    @default("OWE")
  // "credor" ficaria errado quando é você quem emprestou
  counterpart    String    @default("")
  originalAmount Float     @map("original_amount")
  startDate      DateTime? @map("start_date")
  dueDate        DateTime? @map("due_date")
  color          String    @default("#e66767")
  icon           String    @default("🤝")
  notes          String    @default("")
  // Marcada como quitada à mão, para o caso de um acerto fora do app
  isSettled      Boolean   @default(false) @map("is_settled")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  payments Transaction[]

  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carteira dona do registro. Filtrada junto com o usuário em
  // src/lib/db.js: trocar de carteira troca o conjunto inteiro.
  walletId String @map("wallet_id")
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isSettled])
  @@index([direction])
  @@map("debts")
}

// Valor da fatura de um mês específico.
//
// CreditCard.estimatedAmount é o palpite que vale para todo mês futuro;
// quando a fatura real chega, o valor daquele mês entra aqui e passa a
// valer no lugar do palpite. Sem registro, segue a estimativa.
model CardBill {
  id           String   @id @default(uuid())
  creditCardId String   @map("credit_card_id")
  year         Int
  month        Int
  amount       Float
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carteira dona do registro. Filtrada junto com o usuário em
  // src/lib/db.js: trocar de carteira troca o conjunto inteiro.
  walletId String @map("wallet_id")
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([creditCardId, year, month])
  @@index([userId])
  @@map("card_bills")
}

// Compra dividida em parcelas fixas: "Viagem 1/10", "Playstation 2/5".
//
// Diferente de RecurringEntry, que não tem fim, e de Debt, cujos pagamentos
// são irregulares: aqui o valor e a quantidade são conhecidos desde o começo,
// e existe uma última parcela com data.
//
// Nada é gravado como transação futura. As parcelas são projetadas na hora,
// igual às recorrentes, para que mudar a compra não exija apagar dez linhas.
model Installment {
  id          String   @id @default(uuid())
  description String
  totalAmount Float    @map("total_amount")
  // Quantidade total de parcelas. O valor de cada uma sai da divisão, com o
  // resto dos centavos na última, para a soma fechar exatamente com o total.
  count       Int
  // Data da primeira parcela. A enésima cai no mesmo dia, N-1 meses depois.
  firstDate   DateTime @map("first_date")

  // Quem paga. No cartão, a parcela NÃO é uma saída de caixa própria: ela já
  // está dentro da fatura, e somá-la de novo contaria o dinheiro duas vezes.
  // Fora do cartão (carnê, boleto, débito), aí sim é saída no dia dela.
  creditCardId  String? @map("credit_card_id")
  bankAccountId String? @map("bank_account_id")
  categoryId    String? @map("category_id")

  active    Boolean  @default(true)
  notes     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creditCard  CreditCard?  @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carteira dona do registro. Filtrada junto com o usuário em
  // src/lib/db.js: trocar de carteira troca o conjunto inteiro.
  walletId String @map("wallet_id")
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
  @@map("installments")
}

// Regra que liga um pedaço de descrição a uma categoria: "UBER" → Transporte.
//
// Nasce de duas formas: o usuário corrige a categoria de um lançamento e o app
// guarda o padrão, ou a regra é escrita à mão. Determinística e visível — dá
// para conferir por que um lançamento caiu onde caiu, e apagar a regra.
model CategoryRule {
  id         String   @id @default(uuid())
  // Já normalizado (maiúsculas, sem acento) para casar sem surpresa
  pattern    String
  categoryId String   @map("category_id")
  // Quantas vezes já pegou. Regra mais usada ganha na hora do desempate.
  hits       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carteira dona do registro. Filtrada junto com o usuário em
  // src/lib/db.js: trocar de carteira troca o conjunto inteiro.
  walletId String @map("wallet_id")
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, pattern])
  @@index([userId])
  @@map("category_rules")
}

// Uma carteira é um conjunto de finanças que se olha separado: a pessoa
// física e a PJ, tipicamente.
//
// Não é um segundo usuário — é o mesmo dono, com dois conjuntos de dados
// que não se misturam. O `userDb` filtra por dono E por carteira, então
// trocar de carteira no topo da tela troca o app inteiro de contexto.
//
// Tudo que é dinheiro pertence a uma carteira. O que é preferência de quem
// usa (tema, esconder valores, cores do calendário) fica no usuário, porque
// não muda quando você troca de chapéu.
model Wallet {
  id        String   @id @default(uuid())
  name      String
  // PF ou PJ. Muda só as categorias sugeridas ao criar e o rótulo na tela;
  // a mecânica é idêntica nas duas.
  kind      String   @default("PF")
  color     String   @default("#6c5ce7")
  // A que abre quando você entra. Exatamente uma por usuário.
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bankAccounts      BankAccount[]
  categories        Category[]
  transactions      Transaction[]
  monthlySummaries  MonthlySummary[]
  investments       Investment[]
  investmentEntries InvestmentEntry[]
  financialGoals    FinancialGoal[]
  recurringEntries  RecurringEntry[]
  creditCards       CreditCard[]
  debts             Debt[]
  cardBills         CardBill[]
  installments      Installment[]
  categoryRules     CategoryRule[]

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}
