generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection used by the app at runtime (serverless-friendly).
  url       = env("DATABASE_URL")
  // Direct connection required by `prisma migrate` — pgbouncer cannot run DDL.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Preenchidos pelo passo a passo inicial (/onboarding)
  nickname        String?
  financialStatus String?   @map("financial_status")
  savings         Float     @default(0)
  onboardedAt     DateTime? @map("onboarded_at")
  // Preferências de leitura (paleta do calendário). Segue a conta, não o
  // aparelho — tema e olhinho ficam no navegador, ver src/lib/settings.js.
  settings        Json?

  bankAccounts       BankAccount[]
  categories         Category[]
  transactions       Transaction[]
  monthlySummaries   MonthlySummary[]
  investments        Investment[]
  investmentEntries  InvestmentEntry[]
  financialGoals     FinancialGoal[]
  recurringEntries   RecurringEntry[]
  creditCards        CreditCard[]
  debts              Debt[]

  @@map("users")
}

model BankAccount {
  id             String   @id @default(uuid())
  name           String
  color          String   @default("#6c5ce7")
  icon           String   @default("🏦")
  initialBalance Float    @default(0) @map("initial_balance")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  transactions     Transaction[]
  monthlySummaries MonthlySummary[]
  recurringEntries RecurringEntry[]
  creditCards      CreditCard[]

  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("bank_accounts")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String   // INCOME or EXPENSE
  color     String   @default("#6c5ce7")
  icon      String   @default("📌")
  createdAt DateTime @default(now()) @map("created_at")

  transactions     Transaction[]
  recurringEntries RecurringEntry[]

  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("categories")
}

model Transaction {
  id            String   @id @default(uuid())
  date          DateTime
  amount        Float
  type          String   // INCOME, EXPENSE or INVESTMENT
  description   String   @default("")
  bankAccountId String   @map("bank_account_id")
  categoryId    String?  @map("category_id")
  // Preenchido quando type = INVESTMENT: para onde o dinheiro foi
  investmentId  String?  @map("investment_id")
  // Preenchido quando a saída é o pagamento de uma dívida
  debtId        String?  @map("debt_id")
  // Lançamento feito depois do fato; não altera o valor atual do
  // investimento, que já reflete o aporte.
  isRetroactive Boolean  @default(false) @map("is_retroactive")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  investment  Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  // SetNull: apagar a dívida não apaga o pagamento — o dinheiro saiu de fato
  debt        Debt?       @relation(fields: [debtId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([bankAccountId])
  @@index([categoryId])
  @@index([investmentId])
  @@index([debtId])
  @@index([type])
  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("transactions")
}

model MonthlySummary {
  id              String   @id @default(uuid())
  year            Int
  month           Int
  bankAccountId   String   @map("bank_account_id")
  totalIncome     Float    @default(0) @map("total_income")
  totalExpenses   Float    @default(0) @map("total_expenses")
  balance         Float    @default(0)
  vsPreviousMonth Float    @default(0) @map("vs_previous_month")
  closingBalance  Float    @default(0) @map("closing_balance")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([year, month, bankAccountId])
  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("monthly_summaries")
}

model Investment {
  id               String   @id @default(uuid())
  name             String
  type             String   // RENDA_FIXA, RENDA_VARIAVEL, CRIPTO, OUTRO
  institution      String   @default("")
  // Cor no gráfico. Atribuída automaticamente na criação, editável depois.
  color            String   @default("#3987e5")
  currentValue     Float    @default(0) @map("current_value")
  totalInvested    Float    @default(0) @map("total_invested")
  profit           Float    @default(0)
  profitPercentage Float    @default(0) @map("profit_percentage")
  cdiPercentage    Float    @default(0) @map("cdi_percentage")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  entries        InvestmentEntry[]
  financialGoals FinancialGoal[]
  transactions   Transaction[]

  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("investments")
}

model InvestmentEntry {
  id           String   @id @default(uuid())
  investmentId String   @map("investment_id")
  date         DateTime
  type         String   // APORTE, RESGATE, RENDIMENTO
  amount       Float
  description  String   @default("")
  // Aporte lançado depois do fato: entra no histórico sem somar no saldo
  isRetroactive Boolean @default(false) @map("is_retroactive")
  createdAt    DateTime @default(now()) @map("created_at")

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId])
  @@index([date])
  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("investment_entries")
}

model FinancialGoal {
  id                  String    @id @default(uuid())
  name                String
  type                String    // RESERVA_EMERGENCIA, INVESTIMENTO, PATRIMONIO, OUTRO
  targetAmount        Float     @map("target_amount")
  currentAmount       Float     @default(0) @map("current_amount")
  targetDate          DateTime? @map("target_date")
  monthlyContribution Float     @default(0) @map("monthly_contribution")
  investmentId        String?   @map("investment_id")
  isCompleted         Boolean   @default(false) @map("is_completed")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  investment Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)

  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("financial_goals")
}

model RecurringEntry {
  id            String    @id @default(uuid())
  name          String
  type          String    // INCOME or EXPENSE
  amount        Float
  dayOfMonth    Int       @map("day_of_month")
  frequency     String    @default("MONTHLY") // MONTHLY or YEARLY
  monthOfYear   Int?      @map("month_of_year") // only for YEARLY
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  bankAccountId String?   @map("bank_account_id")
  categoryId    String?   @map("category_id")
  creditCardId  String?   @map("credit_card_id")
  notes         String    @default("")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creditCard  CreditCard?  @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([active])
  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("recurring_entries")
}

model CreditCard {
  id              String   @id @default(uuid())
  name            String
  color           String   @default("#6c5ce7")
  icon            String   @default("💳")
  limitAmount     Float    @default(0) @map("limit_amount")
  openingDay      Int      @map("opening_day")   // abertura da fatura
  dueDay          Int      @map("due_day")       // vencimento da fatura
  paymentDay      Int      @map("payment_day")   // dia em que a fatura é paga
  estimatedAmount Float    @default(0) @map("estimated_amount")
  bankAccountId   String?  @map("bank_account_id")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bankAccount BankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  recurring   RecurringEntry[]

  @@index([active])
  // Dono do registro. Toda consulta passa pelo cliente escopado
  // em src/lib/db.js, que injeta este filtro automaticamente.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("credit_cards")
}

// Dinheiro emprestado de alguém, que precisa voltar.
//
// Diferente de RecurringEntry: não há valor fixo nem periodicidade. O que
// existe é um total devido e pagamentos irregulares — R$ 100 num mês,
// nenhum no seguinte, R$ 200 no outro. O saldo é calculado somando as
// transações vinculadas, nunca guardado, para não haver duas verdades.
model Debt {
  id             String    @id @default(uuid())
  name           String
  creditor       String    @default("")
  originalAmount Float     @map("original_amount")
  startDate      DateTime? @map("start_date")
  dueDate        DateTime? @map("due_date")
  color          String    @default("#e66767")
  icon           String    @default("🤝")
  notes          String    @default("")
  // Marcada como quitada à mão, para o caso de um acerto fora do app
  isSettled      Boolean   @default(false) @map("is_settled")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  payments Transaction[]

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isSettled])
  @@map("debts")
}
